---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { url, absolute, github } from '../lib/paths';
import { legalNoticeUrl } from '../data/legal';

interface Props {
  title?: string;
  description?: string;
  /** Crumbs after "owner / blog", e.g. [{ label: 'posts' }, { label: 'x.md' }] */
  crumbs?: { label: string; href?: string }[];
  markdownAlt?: string;
  jsonLd?: object;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description = site.description, crumbs = [], markdownAlt, jsonLd, type = 'website', noindex } = Astro.props;
const fullTitle = title ? `${title} · ${site.owner}/${site.name}` : `${site.owner}/${site.name}: ${site.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={url('logo.webp')} type="image/webp" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={absolute('rss.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={absolute('llms.txt')} />
    {markdownAlt && <link rel="alternate" type="text/markdown" title="Markdown source" href={markdownAlt} />}
    <meta name="theme-color" content="#0c1412" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Dark is the house style; "light" is an opt-in remembered per browser.
      try { if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="logo" href={url('/')} aria-label="Home"><img src={url('logo.webp')} width="32" height="32" alt="" /></a>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={url('/')}>{site.owner}</a><span class="sep">/</span>
          <strong><a href={url('/')}>{site.name}</a></strong>
          {crumbs.map((c) => (
            <>
              <span class="sep">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
        <div class="header-spacer"></div>
        <form class="search" action={url('/')} method="get" role="search">
          <span class="icon"><Icon name="search" /></span>
          <input name="q" type="search" placeholder="Search posts" aria-label="Search posts" autocomplete="off" />
          <kbd class="hide-sm">/</kbd>
        </form>
        <a class="icon-btn hide-sm" href={url('llms.txt')} title="Agent entry point (llms.txt)"><Icon name="hubot" /></a>
        <a class="icon-btn hide-sm" href={url('rss.xml')} title="RSS feed"><Icon name="rss" /></a>
        <button class="icon-btn" type="button" id="theme-toggle" title="Toggle light/dark"><Icon name="sun" /></button>
      </div>
    </header>

    <slot name="head" />

    <div class="layout">
      <aside class="left" aria-label="Profile and pinned"><slot name="left" /></aside>
      <main id="main"><slot /></main>
      <aside class="right" aria-label="About"><slot name="right" /></aside>
    </div>

    <footer class="footer">
      <span>© {new Date().getFullYear()} Marcel Sinn Consulting · München</span>
      <a href={legalNoticeUrl}>Legal notice (Impressum)</a>
      <a href={url('privacy/')}>Privacy</a>
      <a href={github.repo}>Source</a>
      <a href={url('llms.txt')}>llms.txt</a>
      <a href={url('llms-full.txt')}>llms-full.txt</a>
      <a href={url('posts.json')}>posts.json</a>
      <a href={url('rss.xml')}>RSS</a>
      <a href={url('sitemap-index.xml')}>Sitemap</a>
      <span>Written by humans and agents, in the open.</span>
      <span class="disclaimer">Layout inspired by GitHub's interface. Not affiliated with or endorsed by GitHub, Inc.
        Icons: <a href={url('LICENSE-octicons.txt')}>Octicons</a> (MIT, © GitHub Inc.).</span>
    </footer>

    <script is:inline>
      // Theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const light = root.dataset.theme !== 'light';
        if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
        try { light ? localStorage.setItem('theme', 'light') : localStorage.removeItem('theme'); } catch {}
      });
      // "/" focuses search, like GitHub
      addEventListener('keydown', (e) => {
        const t = e.target;
        if (e.key === '/' && !(t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement)) {
          e.preventDefault(); document.querySelector('.search input')?.focus();
        }
      });
      // Copy buttons on code blocks
      document.querySelectorAll('.markdown pre').forEach((pre) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'icon-btn copy-code'; b.textContent = 'Copy'; b.setAttribute('aria-label', 'Copy code');
        b.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText); b.textContent = 'Copied'; }
          catch { b.textContent = 'Failed'; }
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        });
        pre.appendChild(b);
      });
    </script>
  </body>
</html>
